node_modules/

# dist/ is deliberately committed. The README installs this straight from
# GitHub, and a git install never runs prepublishOnly — so the bundle has to be
# in the repo or `npx https://github.com/...` has nothing to run.

# This tool writes its output as CSV into whatever directory it's run from, so
# a stray timestamps.csv from a test run is generated data, not source
*.csv

# Tarballs left behind by `npm pack`
*.tgz

# npm/node noise
npm-debug.log*
.npm/
*.tsbuildinfo

# Credentials, should npm auth or anything else ever land here
.env
.env.*
.npmrc

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
.claude/
